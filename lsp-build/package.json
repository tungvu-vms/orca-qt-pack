{
  "name": "orca-qt-lsp-build",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node dev/test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:ui": "node dev/ui-e2e.mjs",
    "test:ui:large": "node dev/ui-e2e.mjs --large",
    "test:ui:stress": "node dev/ui-e2e.mjs --stress && node dev/ui-e2e.mjs --stress-files",
    "check:build": "node dev/check-build.mjs"
  },
  "dependencies": {
    "monaco-editor": "0.52.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "basedpyright": "^1.40.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.58.2",
    "pyright": "1.1.414",
    "typescript": "5.6.3"
  }
}
